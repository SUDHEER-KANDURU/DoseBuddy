{
  "name": "dosebuddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 tests/integration/*.mysql.test.ts",
    "test:workerd": "powershell -ExecutionPolicy Bypass -File tests/run-web-push-runtime.ps1",
    "verify": "npm run test:unit && npm run build && npm run test:workerd && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.135.0"
  }
}
